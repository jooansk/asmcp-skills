# Automation Studio 6 project: what git should not keep.
# Copy this file into the project folder (where the .apj is) as .gitignore.
# Generated by the build, or one Windows user's own (as_guide 'files').

# Build output and intermediate files; Temp also holds the ARsim installation
/Temp/
/Binaries/

# One Windows user's settings (active configuration, deployment) and the open-project marker
/*.set
/*.isopen

# Each user's Watch, Trace and Profiler setups and recordings (delete these lines to share them)
/Diagnosis/
